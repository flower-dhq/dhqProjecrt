<view wx:if="{{isAlert}}" style="position: fixed;width: 100%;height: 100%;left: 0;right: 0;top: 0;bottom: 0;z-index: 9999;color: #fff;font-size: 13px;text-align: center;">
  <view style='margin-top: 50%;max-width: 60%;min-width: 40%;display: inline-block;padding: 15px 10px;background-color: rgba(66, 66, 66, 0.9); border-radius: 10rpx;'>
    <icon type="{{iconType}}" color="White" size="30"></icon>
    <view style='margin-top: 10px;'>
      {{alertLable}}
    </view>
  </view>
</view>
